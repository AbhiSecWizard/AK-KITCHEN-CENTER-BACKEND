
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Contact Enquiry</title>
</head>

<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">

  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
    New customer enquiry received by AK Kitchen Center.
  </div>

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f3f4f6;padding:30px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:620px;background-color:#ffffff;border-radius:12px;overflow:hidden;">

          <!-- Header -->
          <tr>
            <td style="background-color:#151818;padding:28px 30px;text-align:center;">
              <h1 style="margin:0;color:#f97316;font-size:25px;line-height:1.4;">
                AK Kitchen Center
              </h1>
              <p style="margin:8px 0 0;color:#e5e7eb;font-size:13px;letter-spacing:1px;">
                KITCHEN APPLIANCE REPAIR ENQUIRY
              </p>
            </td>
          </tr>

          <!-- Main content -->
          <tr>
            <td style="padding:30px;">

              <div style="display:inline-block;background-color:#fff7ed;color:#c2410c;padding:8px 12px;border-radius:6px;font-size:12px;font-weight:bold;">
                NEW ENQUIRY
              </div>

              <h2 style="margin:20px 0 10px;font-size:22px;color:#111827;">
                New Contact Form Submission
              </h2>

              <p style="margin:0 0 25px;font-size:14px;line-height:1.7;color:#6b7280;">
                A customer has submitted a message through your website.
                Here are the details.
              </p>

              <!-- Customer details -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border:1px solid #e5e7eb;border-radius:8px;">

                <tr>
                  <td style="padding:15px;border-bottom:1px solid #e5e7eb;width:125px;font-size:13px;font-weight:bold;color:#6b7280;">
                    Customer Name
                  </td>
                  <td style="padding:15px;border-bottom:1px solid #e5e7eb;font-size:14px;color:#111827;word-break:break-word;">
                    <%= name %>
                  </td>
                </tr>

                <tr>
                  <td style="padding:15px;border-bottom:1px solid #e5e7eb;font-size:13px;font-weight:bold;color:#6b7280;">
                    Email Address
                  </td>
                  <td style="padding:15px;border-bottom:1px solid #e5e7eb;font-size:14px;word-break:break-word;">
                    <a href="mailto:<%= email %>" style="color:#ea580c;text-decoration:none;">
                      <%= email %>
                    </a>
                  </td>
                </tr>

                <tr>
                  <td style="padding:15px;font-size:13px;font-weight:bold;color:#6b7280;">
                    Phone Number
                  </td>
                  <td style="padding:15px;font-size:14px;color:#111827;word-break:break-word;">
                    <% if (phone) { %>
                      <a href="tel:<%= phone %>" style="color:#ea580c;text-decoration:none;">
                        <%= phone %>
                      </a>
                    <% } else { %>
                      Not provided
                    <% } %>
                  </td>
                </tr>

              </table>

              <!-- Message -->
              <h3 style="margin:28px 0 12px;font-size:16px;color:#111827;">
                Customer Message
              </h3>

              <div style="padding:18px;background-color:#f9fafb;border-left:4px solid #f97316;border-radius:5px;font-size:14px;line-height:1.8;color:#374151;white-space:pre-wrap;overflow-wrap:anywhere;"><%= message %></div>

              <!-- Reply CTA -->
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:28px;">
                <tr>
                  <td align="center" bgcolor="#f97316" style="border-radius:7px;">
                    <a
                      href="mailto:<%= email %>"
                      style="display:inline-block;padding:14px 22px;color:#ffffff;text-decoration:none;font-size:14px;font-weight:bold;"
                    >
                      Reply to Customer
                    </a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:22px 30px;background-color:#f9fafb;border-top:1px solid #e5e7eb;text-align:center;">
              <p style="margin:0;font-size:13px;font-weight:bold;color:#374151;">
                AK Kitchen Center
              </p>

              <p style="margin:8px 0 0;font-size:12px;line-height:1.7;color:#6b7280;">
                This is an automated notification from your website contact form.
                <br />
                Please do not reply directly to this automated email.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
